#!/usr/bin/env zsh

set -euo pipefail

pushd "$(git rev-parse --show-toplevel)" >/dev/null

README="README.md"

# Shared sqlcmd base args; connection/auth resolved via:
# SQLCMDSERVER, SQLCMDUSER, and SQLCMDPASSWORD env vars.
SQLCMD=(sqlcmd -N disable)

mark() {
  local n=$1 done=$2
  if [[ $done == 1 ]]; then
    sed -E -i "s#🔘\s*\|\s*\*\*Q${n}\*\*#✅ | **Q${n}**#" "$README"
  else
    sed -E -i "s#✅\s*\|\s*\*\*Q${n}\*\*#🔘 | **Q${n}**#" "$README"
  fi
}

db_reachable() {
  "${SQLCMD[@]}" -Q "SELECT 1" >/dev/null 2>&1
}

check_rc() {
  local n=$1
  local rc=0

  # SQL: DDL must run first, then tests (which pull solution via :r)
  if [[ -f "sql/tests/q${n}_tests.sql" ]]; then
    "${SQLCMD[@]}" -i "sql/ddl/q${n}_ddl.sql" \
      >/dev/null 2>&1 || rc=$?
    [[ $rc -eq 0 ]] &&
      "${SQLCMD[@]}" -b -i "sql/tests/q${n}_tests.sql" \
        >/dev/null 2>&1 || rc=$?
    return $rc
  fi

  # PySpark: all pytest tests must pass
  if [[ -f "src/test/python/test_q${n}.py" ]]; then
    poetry run pytest "src/test/python/test_q${n}.py" -q \
      >/dev/null 2>&1 || rc=$?
    return $rc
  fi

  # Theory: file must have more than 1 line (question + answer)
  local tf="theory/q${n}.txt"
  [[ -f $tf ]] && [[ $(wc -l <"$tf") -gt 1 ]] && return 0

  return 1
}

nums=(${(f)"$(grep -oP '(?<=\*\*Q)\d+(?=\*\*)' "$README")"})

# Pre-flight: abort if any SQL question exists but DB is unreachable
for n in $nums; do
  if [[ -f "sql/tests/q${n}_tests.sql" ]] && ! db_reachable; then
    echo "Commit aborted: SQL server unreachable, cannot verify Q${n}."
    exit 1
  fi
done

for n in $nums; do
  local rc=0
  check_rc $n || rc=$?
  [[ $rc -eq 0 ]] && mark $n 1
  [[ $rc -eq 1 ]] && mark $n 0
done

TOTAL=${#nums[@]}
done_count=$(grep -cE '\|\s*✅' "$README" || true)
pct=$((done_count * 100 / TOTAL))
filled=$((done_count * 20 / TOTAL))
empty=$((20 - filled))

bar=""
for ((i = 0; i < filled; i++)); do bar+="█"; done
for ((i = 0; i < empty; i++)); do bar+="░"; done

new_line="${bar}  ${done_count} / ${TOTAL} done (${pct}%)"
sed -i "s|.* / ${TOTAL} done (.*)|${new_line}|" "$README"

git add "$README"

popd >/dev/null
